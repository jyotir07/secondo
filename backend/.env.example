# All variables are optional. SECONDO runs fully locally with no API keys.

SECONDO_DB_PATH=./data/secondo.db
SECONDO_BUSINESS_NAME=Neighbourhood Bakery
SECONDO_BUSINESS_TIMEZONE=Asia/Kolkata
SECONDO_BUSINESS_CURRENCY=INR

# Comma-separated origins allowed to call the API (the Next.js dashboard).
CORS_ORIGINS=http://localhost:3000

# Order extraction: auto (Gemma via Ollama if reachable, else rules) | ollama | rules
EXTRACTION_PROVIDER=auto
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_S=60

# Forecasting: tabpfn (needs `uv sync --extra tabpfn`) | weekday_average | historical_average
# If TabPFN is not installed or fails, the app falls back to weekday_average and says so.
FORECAST_PROVIDER=tabpfn

# Sentry error monitoring + tracing. Off unless SENTRY_DSN is set.
# Message text and customer names are never attached to events.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=1.0
